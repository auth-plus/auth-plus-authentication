{
  "name": "auth-service",
  "version": "1.0.0",
  "description": "Backend Auth Service",
  "scripts": {
    "dev": "nodemon",
    "start": "node build/src/adapters/inbound/http/server.js",
    "lint": "eslint . --fix && prettier . --write",
    "lint:check": "eslint . && prettier . --check",
    "build": "tsc --project tsconfig.json",
    "build:check": "npm run build -- --noEmit",
    "test": "env NODE_ENV=test jest --detectOpenHandles --runInBand --forceExit --silent",
    "stryker": "npx stryker run --logLevel trace"
  },
  "keywords": [
    "express",
    "auth"
  ],
  "main": "build/src/adapters/inbound/http/server.js",
