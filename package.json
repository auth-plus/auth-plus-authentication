    "@types/express": "5.0.6",
    "@types/jest": "30.0.0",
    "@types/jsonwebtoken": "9.0.10",
    "@types/node": "24.10.2",
    "@types/supertest": "7.2.0",
    "@types/swagger-ui-express": "4.1.8",
    "@types/zxcvbn": "4.4.5",
    "@typescript-eslint/parser": "8.62.1",
    "casual": "1.6.2",
    "chai": "6.2.2",
    "eslint": "^10.6.0",
    "eslint-plugin-security": "^4.0.1",
    "eslint-plugin-sonarjs": "^4.1.0",
    "globals": "^17.7.0",
    "husky": "9.1.7",
    "jest": "30.4.2",
    "nock": "14.0.16",
    "nodemon": "3.1.14",
    "nyc": "18.0.0",
